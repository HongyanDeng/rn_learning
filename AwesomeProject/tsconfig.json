{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "build/ts",
    "rootDir": "src",
    "baseUrl": "./src",
    "paths": {
      "@/assets/*":["assets/*"],
      "@/components/*":["components/*"],
      "@/config/*":["config/*"],
      "@/models/*":["models/*"],
      "@/navigator/*":["navigator/*"],
      "@/pages/*":["pages/*"],
      "@/utils/*":["utils/*"],
    }
  }
}